{
  "name": "brown-apma-thesis-defense",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --remote 127.0.0.1",
    "validate:assets": "node scripts/validate_site_assets.mjs",
    "build": "npm run validate:assets && slidev build slides.md",
    "build:pages": "npm run build -- --base /dissertation-defense/ --router-mode hash",
    "test:pages": "BASE_PATH=/dissertation-defense/ ROUTER_MODE=hash node scripts/audit_slides.mjs --pdf",
    "export:pdf": "node scripts/audit_slides.mjs --pdf",
    "test:slides": "node scripts/audit_slides.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@slidev/cli": "52.19.1",
    "@slidev/theme-default": "0.25.0",
    "@fontsource/inter": "5.2.8",
    "three": "0.186.0",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "playwright-chromium": "1.63.0"
  }
}
